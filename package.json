{
  "name": "biodex",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "workspaces": [
    "apps/web",
    "apps/api"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @biodex/web",
    "dev:web": "npm run dev --workspace @biodex/web",
    "dev:api": "npm run dev --workspace @biodex/api",
    "start:api": "npm run start --workspace @biodex/api",
    "migrate:catalog-cache": "npm run migrate:catalog-cache --workspace @biodex/api",
    "build": "npm run build --workspace @biodex/web",
    "build:api": "npm run build --workspace @biodex/api"
  },
  "dependencies": {
    "@neon/config": "^1.10.0",
    "@neon/env": "^1.6.8"
  }
}
