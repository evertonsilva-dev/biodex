{
  "name": "@biodex/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:cloudflare": "vite --mode cloudflare",
    "dev:worker": "wrangler dev --config dist/worker/wrangler.json --ip 127.0.0.1 --port 8787",
    "build": "wrangler types && tsc -p tsconfig.worker.json && tsc -b && vite build",
    "preview": "vite preview",
    "preview:cloudflare": "wrangler preview --config dist/worker/wrangler.json",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.59.20",
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-image-gallery": "^2.1.2",
    "react-leaflet": "^4.2.1",
    "react-select": "^5.10.2",
    "styled-components": "^6.1.13"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.13.0",
    "@types/leaflet": "^1.9.22",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/styled-components": "^5.1.34",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^6.0.1",
    "wrangler": "^4.44.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.66.0"
  }
}
